# Copy these into Replit → Secrets (never commit real values).

# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_SECRET=

# First owner login (used only when the staff list is empty). PIN = 6 digits.
OWNER_PHONE=
OWNER_PIN=

# Public address of the app, used in WhatsApp sign-in links
APP_URL=https://members.mayfairlounge.in

# WhatsApp Cloud API (Meta). Leave empty until the WhatsApp Business number is ready.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_NUMBER=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Test sign-in (codes shown on screen). Set to 1 only while testing, never for real players.
AUTH_TEST_MODE=0

# Set to 1 after adding Object Storage to the Repl (stores selfies and ID photos)
REPLIT_OBJECT_STORAGE=1

# DATABASE_URL is added automatically when you add PostgreSQL to the Repl.
